# ── Banco de dados ────────────────────────────────────────────────────────────
# Desenvolvimento local (Docker)
# DATABASE_URL="postgresql://moby:moby_local_dev@localhost:5432/moby_dev"
# DIRECT_URL="postgresql://moby:moby_local_dev@localhost:5432/moby_dev"

# Neon
DATABASE_URL="postgresql://USER:PASS@ep-xxx.neon.tech/moby?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.neon.tech/moby?sslmode=require&channel_binding=require&connect_timeout=15"

# Bootstrap inicial opcional
# Use apenas para criar o SUPER_ADMIN inicial em um banco vazio.
# O seed não cria tenant, empresa ou qualquer dado de demonstração.
BOOTSTRAP_SUPER_ADMIN_NAME="Administrador MOBY"
BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@seudominio.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="TroquePorUmaSenhaForte123!"

# ── Autenticação ──────────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_DE_64_CHARS_AQUI
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=GERE_OUTRO_SECRET_DE_64_CHARS_AQUI
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moby-storage
R2_PUBLIC_URL=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Alertas (dias antes do vencimento para gerar alerta) ─────────────────────
ALERT_EPI_DAYS_BEFORE=30
ALERT_EXAM_DAYS_BEFORE=30
ALERT_TRAINING_DAYS_BEFORE=30
