# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000,http://localhost:3002
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_DOMAIN=
PRIVATE_STORAGE_ROOT=
LIBREOFFICE_BIN=soffice
PASSWORD_RESET_URL_BASE=http://localhost:3002/redefinir-senha
EMAIL_LOGIN_2FA_ENABLED=true
ALLOW_BOOTSTRAP=true

# Database
DATABASE_URL=postgresql://moby:moby_local_dev@localhost:5432/moby_dev?schema=public
DIRECT_URL=postgresql://moby:moby_local_dev@localhost:5432/moby_dev?schema=public

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m

# Refresh Token
REFRESH_TOKEN_SECRET=change-this-to-another-strong-random-secret-at-least-64-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moby-dev

# Password reset e-mail (Resend)
MAIL_PROVIDER=resend
MAIL_FROM="MOBY SST <no-reply@seudominio.com>"
RESEND_API_KEY=
MAIL_TEST_RECIPIENT=
